# Copy this file to .env and fill in the keys you use.
GEMINI_API_KEY=your_gemini_api_key_here

# Other target planners, read only when MODEL carries that prefix (see src/query_litellm.py):
# azure_openai/ and azure_anthropic/: one Azure Foundry resource, one key, two routes
# AZURE_API_KEY=
# AZURE_OPENAI_API_BASE=https://<resource>.services.ai.azure.com/openai/v1
# AZURE_ANTHROPIC_API_BASE=https://<resource>.services.ai.azure.com/anthropic
# hosted_vllm/ (set by scripts/serve_plan.sub on the GPU node), anthropic/, openai/, litellm_proxy/:
# HOSTED_VLLM_API_BASE=http://localhost:8000/v1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LITELLM_PROXY_API_BASE=
# LITELLM_PROXY_API_KEY=
